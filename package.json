{
  "name": "maeen-uddin-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/flatten-rsc.mjs",
    "build:pages": "cross-env PAGES_BASE_PATH=/personal-site next build && node scripts/flatten-rsc.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build:pages && gh-pages -d out --dotfiles -m \"Deploy site\""
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
